<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_small_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_mascot_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😊"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/widget_calories_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_calories_left"
        android:textColor="#9CA3AF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_calories_val"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="850"
        android:textColor="#10B981"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_fasting_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="#38BDF8"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Vireo"
        android:textColor="#6B7280"
        android:textSize="9sp"
        android:letterSpacing="0.08" />
</LinearLayout>
